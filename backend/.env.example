# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/shiguang

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# 微信小程序
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret
WX_EXPIRY_TMPL_ID=your_subscribe_msg_template_id

# 文件存储
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# 应用
APP_ENV=development
LOG_LEVEL=INFO